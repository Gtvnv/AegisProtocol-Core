# Ignorar arquivos de chaves (Elas devem ser geradas no deploy, nunca versionadas)
keys/
*.pem
*.key
# Exceção: par RSA fixo usado só em teste (KeyManagerServiceTest), sem valor real —
# fica no classpath de propósito para simular uma fonte de chave somente-leitura.
!src/test/resources/testkeys/*.pem

